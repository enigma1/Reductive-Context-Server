# ==============================
# Root Path
# ==============================
# Root path when specified any folders requested will be under this folder
# example: C:/MyProjects/
# When left empty any folder can be accessed as requested by the front-end
# Therefore make sure this only points to drive/folders that must be exposed.
ROOT_PATH=./

# ==============================
# Configuration Path for priming LLMs
# ==============================
AI_ROLES_PATH=./aiRoles
AI_PROFILE=codeAssistant
# ==============================
# Server
# ==============================
# Host and Port where the host operates
BACKEND_HOST=127.0.0.1
BACKEND_PORT=5000

# ==============================
# Frontend
# ==============================
# Front end host/origin where the request is expected to come from
# Default use local system
FRONTEND_HOST=127.0.0.1
FRONTEND_ORIGIN=https://127.0.0.1:5161

# Reflect the incoming Origin header in Access-Control-Allow-Origin.
# 1 = reflect request origin
# 0 = use FRONTEND_ORIGIN
REFLECT_ORIGIN=1

# ==============================
# HTTPS / TLS
# ==============================
# TLS certificate files used when SSL is enabled.
# Examples:
# TLS_KEY=/websites/server.key
# TLS_CERT=/websites/server.crt
# TLS_PASSPHRASE=Password/passphrase used to decrypt an encrypted private key.
# Leave empty if the private key is not encrypted.
TLS_KEY=/path/to/server.key
TLS_CERT=/path/to/server.crt
TLS_PASSPHRASE=

# Enable HTTPS mode.
# 1 = enabled
# 0 = disabled
SSL_ENABLED=1

# ==============================
# Cookies
# ==============================
# Include the Domain attribute in Set-Cookie headers.
# 1 = include Domain
# 0 = omit Domain (host-only cookie)
COOKIE_USE_DOMAIN=0
# Cookie Name
COOKIE_NAME=rcSessionId

# Preferences Directory
PREFERENCES_DIR=prefs

# key to encode the preference filenames with for example 123ABC-456DEF if required
ENCODING_KEY=

# ==============================
# Database
# ==============================
# Path to store the DB
SQL_PATH=./sql/data
# DB name for application storage
SQL_NAME=reductive.db
# DB name for LLM conversation/info storage
SQL_CHECKPOINTS=checkpoints.db

# ==============================
# MOCK Responses
# ==============================
MOCK_OUTPUT_DIR=

# ==============================
# AI Connect
# ==============================
# set AI_MODEL
# ollama:qwen3.5:9b
# openai:gpt-5.4
# anthropic:claude-sonnet-4-6
# google-genai:gemini-3.5-flash
# gemini-3.5-flash-lite
#
# For openai-compatible get am API key from the open router site
# Then add it to the OPENROUTER_API_KEY
# Then use the Get Open Router models option from the Solobase SPA for a full list.
# openai-compatible:openrouter/free
AI_MODEL=
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
