  "version": "0.0.12",
  "author": "Mark Samios",
  "license": "GPL-3.0",
  "keywords": [
    "llm",
    "llm-tools",
    "llm-context",
    "context-engineering",
    "ai-augmentation",
    "tokens-optimization",
    "human-in-the-loop"
  ],
  "type": "module",
  "dependencies": {
    "@dqbd/tiktoken": "^1.0.22",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/formbody": "^9.0.0",
    "@fastify/multipart": "^10.1.2",
    "@fastify/sensible": "^6.0.6",
    "@fastify/session": "^11.1.3",
    "@langchain/anthropic": "^1.5.11",
    "@langchain/core": "^1.2.13",
    "@langchain/google-genai": "^2.3.2",
    "@langchain/langgraph": "^1.4.18",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.4",
    "@langchain/ollama": "^1.3.0",
    "@langchain/openai": "^1.6.0",
    "better-sqlite3": "^13.0.3",
    "csv-stringify": "^6.9.0",
    "fastify": "^5.12.5",
    "langchain": "^1.5.14",
    "lodash-es": "^4.18.1",
    "tree-sitter": "^0.25.1",
    "tree-sitter-python": "^0.25.0",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.3",
    "nodemon": "^1.14.10",
    "tsc-alias": "^1.0.11",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "dev": "tsx watch src/start.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/start.js",
    "db:execute": "tsx scripts/execute-db.ts",
    "tsc": "tsc  --noEmit"
